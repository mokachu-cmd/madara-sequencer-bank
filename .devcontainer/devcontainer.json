{
    "name": "Madara Starknet Environment",
    "image": "mcr.microsoft.com/devcontainers/rust:1",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml"
            ]
        }
    },
    "updateContentCommand": "bash .devcontainer/onCreate.sh",
    "remoteEnv": {
        "LLVM_CONFIG_PATH": "/usr/bin/llvm-config-19"
    }
}
