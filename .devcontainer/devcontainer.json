{
    "name": "Madara Starknet Environment",
    "image": "mcr.microsoft.com/devcontainers/rust:1",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "vadimcn.vscode-lldb",
                "starkware.cairo1"
            ]
        }
    },
    "updateContentCommand": "bash .devcontainer/onCreate.sh",
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y wget gnupg && wget -O - https://apt.llvm.org/llvm.sh | sudo bash -s -- 19 && sudo apt-get install -y libssl-dev pkg-config protobuf-compiler",
    "remoteEnv": {
        "LLVM_CONFIG_PATH": "/usr/bin/llvm-config-19"
    }
}
